{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "primary", "name": "Primary · gece moru", "color": "#665080" },
				{ "slug": "secondary", "name": "Secondary · lavanta yüzey", "color": "#E6DDED" },
				{ "slug": "accent", "name": "Accent · pudra vurgu", "color": "#A45C74" },
				{ "slug": "background", "name": "Background · krem", "color": "#F8F5EF" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFDF9" },
				{ "slug": "raised", "name": "Surface raised", "color": "#EEE7F3" },
				{ "slug": "text", "name": "Text primary", "color": "#292333" },
				{ "slug": "muted", "name": "Text secondary", "color": "#695E71" },
				{ "slug": "border", "name": "Border", "color": "#DAD1DF" },
				{ "slug": "control", "name": "Control border", "color": "#887790" },
				{ "slug": "hover", "name": "Hover", "color": "#523E6B" },
				{ "slug": "on-primary", "name": "On primary", "color": "#FFFDF9" },
				{ "slug": "night", "name": "Night", "color": "#211B30" },
				{ "slug": "blush", "name": "Pudra (dekoratif)", "color": "#F1E1E7" },
				{ "slug": "sand", "name": "Açık bej (dekoratif)", "color": "#EEE6DA" }
			],
			"gradients": [
				{ "slug": "dawn", "name": "Dawn", "gradient": "linear-gradient(135deg,#F8F5EF 0%,#E6DDED 60%,#F1E1E7 100%)" },
				{ "slug": "lunar", "name": "Lunar", "gradient": "linear-gradient(145deg,#EEE7F3,#D9CAE6)" },
				{ "slug": "night", "name": "Night", "gradient": "linear-gradient(135deg,#211B30,#3B2B50)" },
				{ "slug": "dark-aura", "name": "Dark aura", "gradient": "radial-gradient(ellipse at 75% 25%,#493354 0%,#17131F 70%)" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "0 2px 8px rgba(41,35,51,.04)" },
				{ "slug": "md", "name": "Medium", "shadow": "0 12px 32px rgba(41,35,51,.07)" },
				{ "slug": "lg", "name": "Large", "shadow": "0 24px 60px rgba(41,35,51,.10)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "svh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "4", "size": "4px" },
				{ "slug": "20", "name": "8", "size": "8px" },
				{ "slug": "30", "name": "12", "size": "12px" },
				{ "slug": "40", "name": "16", "size": "16px" },
				{ "slug": "50", "name": "24", "size": "24px" },
				{ "slug": "60", "name": "32", "size": "32px" },
				{ "slug": "70", "name": "48", "size": "48px" },
				{ "slug": "80", "name": "64", "size": "clamp(48px, 6vw, 64px)" },
				{ "slug": "90", "name": "96", "size": "clamp(48px, 8vw, 96px)" },
				{ "slug": "100", "name": "128", "size": "clamp(64px, 10vw, 128px)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Quicksand (başlık, marka)",
					"fontFamily": "\"Quicksand\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Quicksand", "fontWeight": "500 600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/quicksand-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Quicksand", "fontWeight": "500 600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/quicksand-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				},
				{
					"slug": "body",
					"name": "DM Sans (metin, arayüz)",
					"fontFamily": "\"DM Sans\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "DM Sans", "fontWeight": "400 600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dmsans-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "DM Sans", "fontWeight": "400 600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dmsans-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				}
			],
			"fontSizes": [
				{ "slug": "eyebrow", "name": "Eyebrow", "size": "0.75rem", "fluid": false },
				{ "slug": "label", "name": "Veri etiketi", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Küçük", "size": "0.875rem", "fluid": false },
				{ "slug": "body", "name": "Gövde", "size": "1rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "article", "name": "Blog gövdesi", "size": "1.0625rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "h3", "name": "H3", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "h2", "name": "H2", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "h1", "name": "H1", "size": "4rem", "fluid": { "min": "2.375rem", "max": "4rem" } }
			]
		},
		"custom": {
			"radius": { "xs": "6px", "sm": "10px", "md": "14px", "lg": "24px", "xl": "32px", "pill": "999px" },
			"motion": { "duration": "180ms", "easing": "ease-out" },
			"control": { "height": "48px", "target": "44px", "focusWidth": "3px", "focusOffset": "3px" }
		},
		"blocks": {
			"core/button": { "border": { "radius": false } }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.2", "letterSpacing": "-0.02em" },
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h-1)", "fontWeight": "500", "lineHeight": "1.08", "letterSpacing": "-0.045em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h-2)", "letterSpacing": "-0.035em" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h-3)", "lineHeight": "1.3" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--hover)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--on-primary)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "fontSize": "0.9375rem", "lineHeight": "1.3" },
				"border": { "radius": "14px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--primary)" },
				"spacing": { "padding": { "top": "0", "bottom": "0", "left": "22px", "right": "22px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--hover)", "text": "var(--wp--preset--color--on-primary)" }, "border": { "color": "var(--wp--preset--color--hover)" } },
				":focus-visible": { "outline": { "color": "var(--wp--preset--color--primary)", "offset": "3px", "style": "solid", "width": "3px" } }
			},
			"caption": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "color": { "text": "var(--wp--preset--color--muted)" } }
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": { "background": "var(--wp--preset--color--surface)", "text": "var(--wp--preset--color--primary)" },
						"border": { "color": "var(--wp--preset--color--control)", "width": "1px", "style": "solid" },
						":hover": { "color": { "background": "var(--wp--preset--color--secondary)", "text": "var(--wp--preset--color--primary)" } }
					}
				}
			},
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "2px", "style": "solid" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.375rem" },
				"spacing": { "padding": { "left": "24px" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
