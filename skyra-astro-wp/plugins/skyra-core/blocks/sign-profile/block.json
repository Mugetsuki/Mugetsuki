{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "skyra/sign-profile",
	"title": "Burç profili",
	"category": "skyra",
	"icon": "id",
	"description": "Burç sayfasının başlığı ve temel bilgileri (H1 içerir).",
	"textdomain": "skyra",
	"attributes": {
		"sign": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "skyra-editor",
	"style": "skyra-blocks",
	"render": "file:./render.php",
	"usesContext": [
		"postId",
		"postType"
	]
}
