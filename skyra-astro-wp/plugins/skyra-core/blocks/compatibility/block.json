{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "skyra/compatibility",
	"title": "Burç uyumu",
	"category": "skyra",
	"icon": "heart",
	"description": "İki burç arasındaki açı ve element ilişkisi.",
	"textdomain": "skyra",
	"attributes": {
		"a": {
			"type": "string",
			"default": "koc"
		},
		"b": {
			"type": "string",
			"default": "terazi"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "skyra-editor",
	"style": "skyra-blocks",
	"render": "file:./render.php",
	"viewScript": "skyra-tools"
}
