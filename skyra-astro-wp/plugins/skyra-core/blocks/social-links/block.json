{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "skyra/social-links",
	"title": "Sosyal / topluluk",
	"category": "skyra",
	"icon": "share",
	"description": "Ayarlar'da tanımlı sosyal medya hesapları.",
	"textdomain": "skyra",
	"attributes": {
		"variant": {
			"type": "string",
			"default": "community"
		},
		"eyebrow": {
			"type": "string",
			"default": "Topluluk"
		},
		"heading": {
			"type": "string",
			"default": "Gökyüzünü birlikte takip edelim"
		},
		"intro": {
			"type": "string",
			"default": "Günlük Ay notları, kısa anlatımlar ve takvim hatırlatmaları sosyal kanallarımızda."
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "skyra-editor",
	"style": "skyra-blocks",
	"render": "file:./render.php"
}
