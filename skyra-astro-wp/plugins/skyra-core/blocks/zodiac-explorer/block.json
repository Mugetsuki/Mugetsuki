{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "skyra/zodiac-explorer",
	"title": "Burçları keşfet",
	"category": "skyra",
	"icon": "star-filled",
	"description": "12 burç, element gruplarıyla editoryal ızgara ve filtre.",
	"textdomain": "skyra",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "12 burç"
		},
		"heading": {
			"type": "string",
			"default": "Burçları keşfet"
		},
		"intro": {
			"type": "string",
			"default": "Her burç bir element ve bir nitelik taşır. Birlikte okununca, bir haritadaki enerjinin nasıl aktığını anlatırlar."
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
