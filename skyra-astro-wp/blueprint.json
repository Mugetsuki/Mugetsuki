{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Skyra Astro",
		"description": "Skyra Astro teması ve Skyra Core eklentisi; sayfalar, burçlar ve başlangıç içeriğiyle.",
		"author": "Skyra Astro"
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"login": true,
	"steps": [
		{ "step": "setSiteLanguage", "language": "tr_TR" },
		{ "step": "activatePlugin", "pluginPath": "skyra-core/skyra-core.php" },
		{ "step": "activateTheme", "themeFolderName": "skyra" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; \\Skyra\\Core\\Setup::run();" }
	]
}
